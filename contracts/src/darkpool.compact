pragma language_version >= 0.22;
import CompactStandardLibrary;

export enum OrderSide {
    BUY,
    SELL
}

export enum OrderStatus {
    OPEN,
    PARTIALLY_FILLED,
    FILLED,
    CANCELLED
}

export struct Order {
    trader: Bytes<32>;
    side: OrderSide;
    baseToken: Bytes<32>;
    quoteToken: Bytes<32>;
    amountCommitment: Bytes<32>;
    priceCommitment: Bytes<32>;
    remainingAmount: Uint<64>;
    status: OrderStatus;
    escrowAmount: Uint<128>;
}

// Public ledger state
export ledger orders: Map<Bytes<32>, Order>;
export ledger balances: Map<Bytes<32>, Uint<128>>;
export ledger totalValueShielded: Uint<128>;

// Private witness callback: caller supplies private secret from local storage
witness callerSecret(): Bytes<32>;

// Cryptographic identity derivation: prevents impersonation while preserving privacy
circuit traderAccountOf(sk: Bytes<32>): Bytes<32> {
    return persistentHash<Vector<2, Bytes<32>>>([pad(32, "darkpool:trader:v1"), sk]);
}

// Composite key for trader and token balance lookup
circuit balanceKey(trader: Bytes<32>, token: Bytes<32>): Bytes<32> {
    return persistentHash<Vector<2, Bytes<32>>>([trader, token]);
}

constructor() {
    totalValueShielded = 0;
}

// Deposit funds into the Dark Pool internal balance for escrowed trading
export circuit deposit(token: Bytes<32>, amount: Uint<128>): [] {
    assert(amount > 0, "Deposit amount must be positive");
    receiveUnshielded(disclose(token), disclose(amount));
    const trader = traderAccountOf(callerSecret());
    const key = balanceKey(trader, token);
    const disKey = disclose(key);
    const currentBal = balances.member(disKey) ? balances.lookup(disKey) : (0 as Uint<128>);
    balances.insert(disKey, disclose((currentBal + amount) as Uint<128>));
    totalValueShielded = disclose((totalValueShielded + amount) as Uint<128>);
}

// Withdraw unescrowed settled funds back to user address
export circuit withdraw(token: Bytes<32>, amount: Uint<128>, recipient: UserAddress): [] {
    assert(amount > 0, "Withdraw amount must be positive");
    const trader = traderAccountOf(callerSecret());
    const key = balanceKey(trader, token);
    const disKey = disclose(key);
    assert(balances.member(disKey), "No balance found for token");
    const currentBal = balances.lookup(disKey);
    assert(currentBal >= amount, "Insufficient balance for withdrawal");
    sendUnshielded(
        disclose(token),
        disclose(amount),
        right<ContractAddress, UserAddress>(disclose(recipient))
    );
    balances.insert(disKey, disclose((currentBal - amount) as Uint<128>));
    totalValueShielded = disclose((totalValueShielded - amount) as Uint<128>);
}

// Submit a hidden order with cryptographic commitments and locked escrow
export circuit submitOrder(
    orderId: Bytes<32>,
    baseToken: Bytes<32>,
    quoteToken: Bytes<32>,
    side: OrderSide,
    amount: Uint<64>,
    price: Uint<64>,
    salt: Bytes<32>
): [] {
    const disOrderId = disclose(orderId);
    assert(!orders.member(disOrderId), "Order already exists");
    assert(amount > 0, "Amount must be positive");
    assert(price > 0, "Price must be positive");

    const trader = traderAccountOf(callerSecret());

    // Calculate required escrow from trader's internal balance
    // BUY: escrow quoteToken = amount * price
    // SELL: escrow baseToken = amount
    const escrowRequired: Uint<128> = (side == OrderSide.BUY)
        ? (((amount as Field) * (price as Field)) as Uint<128>)
        : (amount as Uint<128>);
    const escrowToken: Bytes<32> = (side == OrderSide.BUY) ? quoteToken : baseToken;

    const escrowKey = balanceKey(trader, escrowToken);
    const disEscrowKey = disclose(escrowKey);
    assert(balances.member(disEscrowKey), "No escrow balance available for token");
    const available = balances.lookup(disEscrowKey);
    assert(available >= escrowRequired, "Insufficient balance to escrow order");

    balances.insert(disEscrowKey, disclose((available - escrowRequired) as Uint<128>));

    // Cryptographic commitments: hiding exact amount and price on-chain
    const amtComm = persistentCommit<Uint<64>>(amount, salt);
    const prcComm = persistentCommit<Uint<64>>(price, salt);

    orders.insert(disOrderId, Order {
        trader: disclose(trader),
        side: disclose(side),
        baseToken: disclose(baseToken),
        quoteToken: disclose(quoteToken),
        amountCommitment: amtComm,
        priceCommitment: prcComm,
        remainingAmount: disclose(amount),
        status: OrderStatus.OPEN,
        escrowAmount: disclose(escrowRequired)
    });
}

// Cancel an active order with authentication and escrow refund
export circuit cancelOrder(
    orderId: Bytes<32>,
    amount: Uint<64>,
    price: Uint<64>,
    salt: Bytes<32>
): [] {
    const disOrderId = disclose(orderId);
    assert(orders.member(disOrderId), "Order does not exist");
    const order = orders.lookup(disOrderId);
    assert(order.status == OrderStatus.OPEN || order.status == OrderStatus.PARTIALLY_FILLED, "Order is not active for cancellation");

    // Authenticate caller: only the order owner can cancel!
    const caller = traderAccountOf(callerSecret());
    assert(caller == order.trader, "Unauthorized: caller is not the order owner");

    // Verify commitments
    assert(persistentCommit<Uint<64>>(amount, salt) == order.amountCommitment, "Amount commitment mismatch");
    assert(persistentCommit<Uint<64>>(price, salt) == order.priceCommitment, "Price commitment mismatch");

    // Compute refund of remaining escrow
    const refundAmount: Uint<128> = (order.side == OrderSide.BUY)
        ? (((order.remainingAmount as Field) * (price as Field)) as Uint<128>)
        : (order.remainingAmount as Uint<128>);
    const refundToken: Bytes<32> = (order.side == OrderSide.BUY) ? order.quoteToken : order.baseToken;

    const refundKey = balanceKey(order.trader, refundToken);
    const disRefundKey = disclose(refundKey);
    const currentBal = balances.member(disRefundKey) ? balances.lookup(disRefundKey) : (0 as Uint<128>);
    balances.insert(disRefundKey, disclose((currentBal + refundAmount) as Uint<128>));

    orders.insert(disOrderId, Order {
        trader: order.trader,
        side: order.side,
        baseToken: order.baseToken,
        quoteToken: order.quoteToken,
        amountCommitment: order.amountCommitment,
        priceCommitment: order.priceCommitment,
        remainingAmount: 0,
        status: OrderStatus.CANCELLED,
        escrowAmount: 0
    });
}

// Match buy and sell orders with ZK inequality proof, partial fills, and atomic settlement
export circuit matchOrders(
    buyOrderId: Bytes<32>,
    sellOrderId: Bytes<32>,
    fillAmount: Uint<64>,
    matchPrice: Uint<64>,
    buyAmount: Uint<64>,
    buyPrice: Uint<64>,
    sellAmount: Uint<64>,
    sellPrice: Uint<64>,
    buySalt: Bytes<32>,
    sellSalt: Bytes<32>
): [] {
    const disBuyOrderId = disclose(buyOrderId);
    const disSellOrderId = disclose(sellOrderId);
    assert(orders.member(disBuyOrderId), "Buy order missing");
    assert(orders.member(disSellOrderId), "Sell order missing");

    const buyOrder = orders.lookup(disBuyOrderId);
    const sellOrder = orders.lookup(disSellOrderId);

    assert(buyOrder.status == OrderStatus.OPEN || buyOrder.status == OrderStatus.PARTIALLY_FILLED, "Buy order not active");
    assert(sellOrder.status == OrderStatus.OPEN || sellOrder.status == OrderStatus.PARTIALLY_FILLED, "Sell order not active");
    assert(buyOrder.side == OrderSide.BUY && sellOrder.side == OrderSide.SELL, "Invalid order sides");
    assert(buyOrder.baseToken == sellOrder.baseToken && buyOrder.quoteToken == sellOrder.quoteToken, "Token pair mismatch");

    // Commitment checks
    assert(persistentCommit<Uint<64>>(buyAmount, buySalt) == buyOrder.amountCommitment, "Buy amount commitment mismatch");
    assert(persistentCommit<Uint<64>>(buyPrice, buySalt) == buyOrder.priceCommitment, "Buy price commitment mismatch");
    assert(persistentCommit<Uint<64>>(sellAmount, sellSalt) == sellOrder.amountCommitment, "Sell amount commitment mismatch");
    assert(persistentCommit<Uint<64>>(sellPrice, sellSalt) == sellOrder.priceCommitment, "Sell price commitment mismatch");

    // ZK Price constraints
    assert(buyPrice >= sellPrice, "No price overlap: buyPrice must be >= sellPrice");
    assert(matchPrice >= sellPrice && matchPrice <= buyPrice, "matchPrice must be between sellPrice and buyPrice");

    // Fill constraints
    assert(fillAmount > 0, "fillAmount must be positive");
    assert(fillAmount <= buyOrder.remainingAmount, "fillAmount exceeds buy remaining amount");
    assert(fillAmount <= sellOrder.remainingAmount, "fillAmount exceeds sell remaining amount");

    // Compute updated remaining amounts and statuses
    const buyRemaining: Uint<64> = (buyOrder.remainingAmount - fillAmount) as Uint<64>;
    const sellRemaining: Uint<64> = (sellOrder.remainingAmount - fillAmount) as Uint<64>;

    const buyStatus: OrderStatus = (buyRemaining == 0) ? OrderStatus.FILLED : OrderStatus.PARTIALLY_FILLED;
    const sellStatus: OrderStatus = (sellRemaining == 0) ? OrderStatus.FILLED : OrderStatus.PARTIALLY_FILLED;

    // Real Asset Settlement
    // 1. Buyer receives fillAmount of baseToken
    const buyerBaseKey = balanceKey(buyOrder.trader, buyOrder.baseToken);
    const disBuyerBaseKey = disclose(buyerBaseKey);
    const buyerBaseBal = balances.member(disBuyerBaseKey) ? balances.lookup(disBuyerBaseKey) : (0 as Uint<128>);
    balances.insert(disBuyerBaseKey, disclose((buyerBaseBal + (fillAmount as Uint<128>)) as Uint<128>));

    // 2. Seller receives (fillAmount * matchPrice) of quoteToken
    const quoteProceeds: Uint<128> = ((fillAmount as Field) * (matchPrice as Field)) as Uint<128>;
    const sellerQuoteKey = balanceKey(sellOrder.trader, sellOrder.quoteToken);
    const disSellerQuoteKey = disclose(sellerQuoteKey);
    const sellerQuoteBal = balances.member(disSellerQuoteKey) ? balances.lookup(disSellerQuoteKey) : (0 as Uint<128>);
    balances.insert(disSellerQuoteKey, disclose((sellerQuoteBal + quoteProceeds) as Uint<128>));

    // 3. Price improvement refund: if matchPrice < buyPrice, refund excess quote escrow back to buyer
    const surplus: Uint<128> = (buyPrice > matchPrice)
        ? (((fillAmount as Field) * ((buyPrice - matchPrice) as Field)) as Uint<128>)
        : (0 as Uint<128>);
    const buyerQuoteKey = balanceKey(buyOrder.trader, buyOrder.quoteToken);
    const disBuyerQuoteKey = disclose(buyerQuoteKey);
    const buyerQuoteBal = balances.member(disBuyerQuoteKey) ? balances.lookup(disBuyerQuoteKey) : (0 as Uint<128>);
    balances.insert(disBuyerQuoteKey, disclose((buyerQuoteBal + surplus) as Uint<128>));

    const buyEscrowUsed: Uint<128> = ((fillAmount as Field) * (buyPrice as Field)) as Uint<128>;
    const sellEscrowUsed = fillAmount as Uint<128>;

    orders.insert(disBuyOrderId, disclose(Order {
        trader: buyOrder.trader,
        side: buyOrder.side,
        baseToken: buyOrder.baseToken,
        quoteToken: buyOrder.quoteToken,
        amountCommitment: buyOrder.amountCommitment,
        priceCommitment: buyOrder.priceCommitment,
        remainingAmount: buyRemaining,
        status: buyStatus,
        escrowAmount: (buyOrder.escrowAmount - buyEscrowUsed) as Uint<128>
    }));

    orders.insert(disSellOrderId, disclose(Order {
        trader: sellOrder.trader,
        side: sellOrder.side,
        baseToken: sellOrder.baseToken,
        quoteToken: sellOrder.quoteToken,
        amountCommitment: sellOrder.amountCommitment,
        priceCommitment: sellOrder.priceCommitment,
        remainingAmount: sellRemaining,
        status: sellStatus,
        escrowAmount: (sellOrder.escrowAmount - sellEscrowUsed) as Uint<128>
    }));
}
